# URL da Arena Brasil Scheduler API, sem barra no final (obrigatória no build de produção;
# em `npm run dev` o padrão é http://localhost:8080)
VITE_API_BASE_URL=https://arena-brasil-scheduler-api-production.up.railway.app
# WhatsApp da arena com DDI, só dígitos. Usado em "Pedir cancelamento".
# Opcional: o padrão é o da Arena Brasil (+55 48 9633-1978).
VITE_ARENA_WHATSAPP=554896331978
# Fuso da arena (o mesmo APP_TIMEZONE da API)
VITE_ARENA_TIMEZONE=America/Sao_Paulo
